# Épure — variables d'environnement
#
# EN LOCAL : aucune variable n'est nécessaire. Sans POSTGRES_URL, l'app
# utilise SQLite (fichier data/epure.db créé automatiquement).
#
# SUR VERCEL : ajoute une base Postgres (Storage > Create Database > Postgres).
# Vercel injecte alors POSTGRES_URL automatiquement — rien à copier à la main.
# Pour un test en local contre Postgres, décommente et renseigne :
# POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# Secret protégeant l'endpoint du Cron (/api/cron/pulse).
# Sur Vercel, définis CRON_SECRET dans les variables du projet : Vercel
# l'enverra automatiquement en en-tête Authorization lors des exécutions Cron.
# CRON_SECRET="change-me"

# Port du serveur local (défaut : 3000)
# PORT=3000
